{
  "name": "@smonn/db",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "smonndb": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./dev": "./dist/dev.mjs",
    "./node": "./dist/node.mjs",
    "./postgres-js": "./dist/postgres-js.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "check": "node scripts/check.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check:imports": "node scripts/check-imports.ts",
    "check:index": "node scripts/check-index-exports.ts",
    "check:issue": "node scripts/check-issue-milestone.ts",
    "check:mermaid": "node scripts/check-mermaid.ts",
    "check:static": "node scripts/check.ts --static",
    "check:pr": "node scripts/check-pr.ts",
    "coverage": "vitest run --coverage",
    "deps": "rev-dep config run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fta": "node scripts/fta-check.ts",
    "fta:update": "node scripts/fta-check.ts --update",
    "knip": "knip",
    "lint": "oxlint",
    "lint:actions": "node scripts/actionlint.ts",
    "prepack": "pnpm run build",
    "prepare": "lefthook install --reset-hooks-path",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "fta-cli": "^3.1.0",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postgres": "^3.4.9",
    "rev-dep": "^3.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "postgres": "^3.4.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
