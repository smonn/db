{
  "name": "@smonn/db",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smonn/db.git"
  },
  "bin": {
    "smonndb": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cli.mjs"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./dev": "./dist/dev.mjs",
    "./node": "./dist/node.mjs",
    "./postgres-js": "./dist/postgres-js.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "node scripts/check.ts",
    "check:branch": "node scripts/check-branch.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check:imports": "node scripts/check-imports.ts",
    "check:index": "node scripts/check-index-exports.ts",
    "check:issue": "node scripts/check-issue-milestone.ts",
    "check:labels": "node scripts/check-issue-labels.ts",
    "check:mermaid": "node scripts/check-mermaid.ts",
    "check:node-version": "node scripts/check-node-version.ts",
    "check:oidc": "node scripts/check-oidc-jobs.ts",
    "check:parent": "node scripts/check-issue-parent.ts",
    "check:readme": "node scripts/check-readme-examples.ts",
    "check:static": "node scripts/check.ts --static",
    "check:pr": "node scripts/check-pr.ts",
    "clear:review": "node scripts/clear-stale-review.ts",
    "coverage": "vitest run --coverage",
    "deps": "rev-dep config run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "complexity": "node scripts/complexity.ts",
    "fta": "node scripts/fta-check.ts",
    "fta:update": "node scripts/fta-check.ts --update",
    "knip": "knip",
    "lint": "oxlint",
    "lint:actions": "node scripts/actionlint.ts",
    "mutation": "stryker run",
    "mutation:dry": "stryker run --dryRunOnly",
    "mutation:failure": "node scripts/mutation-failure.ts",
    "mutation:mark": "node scripts/mark-stryker-disables.ts",
    "mutation:report": "node scripts/mutation-report.ts",
    "prepack": "pnpm run build",
    "prepare": "lefthook install --reset-hooks-path",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@swc/core": "^1.16.18",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "fta-cli": "^3.1.0",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "postgres": "^3.4.9",
    "rev-dep": "^3.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "postgres": "^3.4.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "download"
    }
  }
}
