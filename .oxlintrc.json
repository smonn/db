{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "vitest"],
  "jsPlugins": ["./scripts/lint-plugin.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    // Baseline at adoption (2026-10-22): complexity 21 (dev/diff/hazards.ts). Target: 6. Lower it
    // as functions are split.
    "complexity": ["error", { "max": 21 }],
    "max-params": ["error", { "max": 4 }],
    "max-depth": ["error", { "max": 4 }],
    // A backstop; fta judges file maintainability, so this stays above the largest file.
    "max-lines": ["error", { "max": 300 }],
    // vi.importActual's type argument needs `typeof import()`.
    "typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": false }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/prefer-readonly-parameter-types": "off",
    "unicorn/no-empty-file": "off",
    "smonn/sql-interpolation": "error",
    "smonn/required-brand": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "eslint/max-lines-per-function": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test-helper.ts"],
      "rules": {
        "smonn/sql-interpolation": "off"
      }
    },
    {
      "files": ["src/**"],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          { "name": "process", "message": "Only adapters/ and dev/cli touch Node globals." },
          { "name": "Buffer", "message": "Only adapters/ and dev/cli touch Node globals." },
          { "name": "__dirname", "message": "Only adapters/ and dev/cli touch Node globals." }
        ]
      }
    },
    {
      "files": ["src/runtime/**", "src/adapters/**"],
      "rules": {
        "eslint/no-restricted-properties": [
          "error",
          {
            "property": "createCurrentTable",
            "message": "Only dev/ creates the current table, per ADR-0016."
          }
        ]
      }
    },
    {
      "files": ["src/adapters/**", "src/dev/cli/**"],
      "rules": {
        "eslint/no-restricted-globals": "off"
      }
    }
  ]
}
