{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "customManagers": [
    {
      "description": "A bump of the actionlint version also needs the new release sums in the same file.",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/actionlint\\.ts$/"],
      "matchStrings": ["export const version = \"(?<currentValue>[^\"]+)\";"],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "One PR bumps .tool-versions and devEngines.runtime; pnpm regenerates the lockfile entry. scripts/check-node-version.ts guards the three copies.",
      "matchManagers": ["asdf", "npm"],
      "matchDepNames": ["node"],
      "groupName": "Node.js runtime"
    },
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "devDependencies (non-major)"
    }
  ]
}
